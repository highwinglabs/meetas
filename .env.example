# =============================================================================
# meeting-assistant — example environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` (in the project directory or in MA_BASE_DIR) and
# adjust the values you need. The core reads `MA_*` environment variables, so
# a `.env` file is honored automatically at startup (see README "Configuration").
#
# Precedence (highest wins):
#   1. Real environment variables (e.g. exported in your shell / systemd)
#   2. Values in a `.env` file
#   3. config.json in MA_BASE_DIR
#   4. Built-in defaults
#
# Every value below matches the built-in default. Leave a line commented out to
# keep the default, or uncomment and change it. No credentials are required:
# this app is offline-first and never needs API keys, tokens, or passwords.
# =============================================================================

# --- Storage -----------------------------------------------------------------
# All data (SQLite DB, audio, exports, logs, state) lives under MA_BASE_DIR.
# Nothing is written anywhere else. Default: ~/.local/share/meeting_assistant
#MA_BASE_DIR=/home/USER/.local/share/meeting_assistant

# --- API (local only) --------------------------------------------------------
# The server binds to loopback by default. Do NOT change the host to a public
# address unless you fully understand the security implications: the API has no
# authentication and is designed to be reachable only on 127.0.0.1.
MA_HOST=127.0.0.1
MA_PORT=8765

# --- Privacy / network -------------------------------------------------------
# Offline by default. Network access is blocked and model downloads require an
# explicit confirmation. Set to `true` only if you intentionally want the core
# to be allowed to download ASR models from the network.
MA_NETWORK_ALLOWED=false

# --- Audio capture -----------------------------------------------------------
MA_SAMPLE_RATE=16000
MA_CHANNELS=1
# Pick an input device by case-insensitive substring of its name, e.g.
# "headset" or "microphone". Leave unset to use the system default device.
#MA_INPUT_DEVICE_NAME=
# Or an explicit PortAudio device index as a fallback:
#MA_INPUT_DEVICE_INDEX=

# --- ASR (automatic speech recognition, local) -------------------------------
# Default/final model, live model, and fallback model are independent.
MA_ASR_MODEL=small
MA_LIVE_ASR_MODEL=parakeet-tdt-0.6b-v3-int8
MA_LIVE_FALLBACK_ASR_MODEL=small
MA_QUALITY_ASR_MODEL=small
MA_ASR_COMPUTE=int8
# Auto-detect language per meeting; set to "de" or "en" to force one.
#MA_ASR_LANGUAGE=

# --- Live transcription & speaker diarization (offline, opt-in) --------------
MA_LIVE_TRANSCRIPTION=false
MA_LIVE_WINDOW_S=10.0
MA_LIVE_PERIOD_S=2.0
MA_LIVE_TAIL_S=2.0
MA_SPEAKER_DIARIZATION=false
# "numpy" is the dependency-free offline default; "pyannote" needs a model
# download (network-gated) and PyTorch.
MA_DIARIZATION_BACKEND=numpy

# --- LLM (an already-running local OpenAI-compatible server) -----------------
# The app never starts its own model server; it only points at one you already
# run (e.g. llama.cpp `/v1` or Ollama's OpenAI-compatible endpoint). These are
# loopback URLs by default.
MA_LLM_BASE_URL=http://127.0.0.1:8081/v1
MA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Must match a model id your local server reports under /v1/models.
MA_LLM_MODEL=qwen3.8-27b-q4kxl
# Force the deterministic mock LLM (no server call) for development and tests.
MA_LLM_MOCK=false
MA_LLM_TEMPERATURE=0.2
MA_LLM_MAX_TOKENS=8192
MA_LLM_TIMEOUT=300.0
MA_LLM_MAX_BUSY_RETRIES=10
MA_LLM_BUSY_WAIT=3.0
# Optional per-role provider overrides as JSON (see README "Model profiles").
#MA_MODEL_PROFILES={"analyse": {"base_url": "http://127.0.0.1:8081/v1", "model": "my-model"}}

# --- Search / RAG (local, offline) -------------------------------------------
MA_EMBEDDINGS=true
MA_EMBEDDING_DIM=256
MA_RAG=true
MA_RAG_TOP_K=6
MA_RERANKING=false

# --- Tasks & pipeline --------------------------------------------------------
MA_TASKS=true
MA_AUTO_TITLE_TAGS=true
MA_AUTO_PIPELINE=false
MA_AUTO_ANALYZE=false
MA_PIPELINE_MAX_RETRIES=3
MA_PIPELINE_MAX_WORKERS=1

# --- Upload limits (bytes) ---------------------------------------------------
# Hard caps that keep a single request from exhausting memory/disk.
MA_MAX_UPLOAD_BYTES=4294967296
MA_MAX_UPLOAD_CHUNK_BYTES=268435456

# --- Logging -----------------------------------------------------------------
MA_LOG_LEVEL=INFO
